{
  "openapi": "3.0.3",
  "info": {
    "title": "Auth Service API",
    "version": "1.1.0",
    "description": "SSO/OIDC provider for the Codevertex platform."
  },
  "servers": [
    { "url": "https://sso.codevertexafrica.com", "description": "Production (default)" },
    { "url": "https://auth.codevertex.local:4101", "description": "Local development (HTTPS)" }
  ],
  "tags": [
    { "name": "Auth", "description": "Registration, login, session, password reset, and self-service MFA." },
    { "name": "OAuth", "description": "OAuth/OIDC authorization code flow and social login." },
    { "name": "Discovery", "description": "OIDC discovery and JWKS endpoints." },
    { "name": "Health", "description": "Service health check." },
    { "name": "Admin", "description": "Platform-admin-only tenant, client, and entitlement management." }
  ],
  "components": {
    "securitySchemes": {
      "bearerAuth": { "type": "http", "scheme": "bearer", "bearerFormat": "JWT" }
    },
    "schemas": {
      "TenantDomain": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "tenant_id": {
            "type": "string",
            "format": "uuid"
          },
          "service": {
            "type": "string",
            "example": "ordering"
          },
          "service_name": {
            "type": "string",
            "example": "Online store and ordering"
          },
          "hostname": {
            "type": "string",
            "example": "shop.example.co.ke"
          },
          "status": {
            "type": "string",
            "enum": [
              "pending_dns",
              "issuing",
              "active",
              "failed",
              "removing"
            ]
          },
          "dns_mode": {
            "type": "string",
            "enum": [
              "cloudflare",
              "external"
            ]
          },
          "dns_record": {
            "type": "object",
            "description": "The record to add at the domain provider (external DNS only).",
            "properties": {
              "type": {
                "type": "string"
              },
              "name": {
                "type": "string"
              },
              "value": {
                "type": "string"
              }
            }
          },
          "last_error": {
            "type": "string"
          },
          "last_checked_at": {
            "type": "string",
            "format": "date-time"
          },
          "activated_at": {
            "type": "string",
            "format": "date-time"
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          },
          "url": {
            "type": "string",
            "example": "https://shop.example.co.ke"
          }
        }
      },
      "DomainResolution": {
        "type": "object",
        "properties": {
          "hostname": {
            "type": "string"
          },
          "tenant_id": {
            "type": "string",
            "format": "uuid"
          },
          "tenant_slug": {
            "type": "string"
          },
          "service": {
            "type": "string"
          },
          "status": {
            "type": "string"
          }
        }
      },
      "PublicTenant": {
        "type": "object",
        "description": "Safe public fields of a tenant (no secrets, no member data).",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "name": {
            "type": "string"
          },
          "slug": {
            "type": "string"
          },
          "status": {
            "type": "string"
          },
          "use_case": {
            "type": "string"
          },
          "contact_phone": {
            "type": "string"
          },
          "contact_email": {
            "type": "string"
          },
          "metadata": {
            "type": "object",
            "description": "Branding and app names (logo_url, primary_color, service_branding)."
          }
        }
      },
      "RegisterRequest": {
        "type": "object",
        "properties": {
          "email": { "type": "string", "example": "user@example.com" },
          "password": { "type": "string", "example": "StrongPassw0rd!" },
          "tenant_slug": { "type": "string", "example": "codevertex" }
        },
        "required": ["email","password","tenant_slug"]
      },
      "LoginRequest": {
        "type": "object",
        "properties": {
          "email": { "type": "string", "example": "admin@demo.codevertexafrica.com" },
          "password": { "type": "string", "format": "password" },
          "tenant_slug": { "type": "string", "example": "codevertex-demo" }
        },
        "required": ["email","password","tenant_slug"]
      },
      "PasswordResetRequest": {
        "type": "object",
        "properties": {
          "email": { "type": "string", "example": "user@example.com" },
          "tenant_slug": { "type": "string", "example": "codevertex" }
        },
        "required": ["email","tenant_slug"]
      },
      "PasswordResetConfirm": {
        "type": "object",
        "properties": {
          "token": { "type": "string", "example": "reset-token" },
          "new_password": { "type": "string", "example": "NewStrongPassw0rd!" }
        },
        "required": ["token","new_password"]
      }
    }
  },
  "security": [ { "bearerAuth": [] } ],
  "paths": {
    "/api/v1/tenants/by-slug/{slug}": {
      "get": {
        "tags": [
          "Discovery"
        ],
        "summary": "Public tenant record by slug",
        "description": "Used by storefronts and websites for branding, contact details and the tenant id public POS routes need.",
        "parameters": [
          {
            "name": "slug",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Tenant",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PublicTenant"
                }
              }
            }
          },
          "404": {
            "description": "No tenant with this slug"
          }
        }
      }
    },
    "/api/v1/domains/resolve": {
      "get": {
        "tags": [
          "Discovery"
        ],
        "summary": "Which tenant and service an active custom domain belongs to",
        "description": "Frontend proxies call this for hosts they do not know, then serve that tenant's app.",
        "parameters": [
          {
            "name": "host",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "example": "shop.example.co.ke"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Active domain",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DomainResolution"
                }
              }
            }
          },
          "404": {
            "description": "No active tenant domain for this host"
          }
        }
      }
    },
    "/api/v1/domains/services": {
      "get": {
        "tags": [
          "Discovery"
        ],
        "summary": "Services a custom domain can be connected to",
        "responses": {
          "200": {
            "description": "Service list and whether custom domains are enabled"
          }
        }
      }
    },
    "/api/v1/admin/tenants/{tenant_id}/domains": {
      "get": {
        "tags": [
          "Admin"
        ],
        "summary": "List a tenant's custom domains",
        "description": "Tenant admins for their own tenant; platform owners for any tenant.",
        "parameters": [
          {
            "name": "tenant_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Domains",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/TenantDomain"
                      }
                    },
                    "enabled": {
                      "type": "boolean"
                    }
                  }
                }
              }
            }
          }
        }
      },
      "post": {
        "tags": [
          "Admin"
        ],
        "summary": "Connect a custom domain",
        "description": "In a zone the platform manages, DNS is set up automatically; otherwise the response carries the record to add and the domain finishes on its own once it resolves.",
        "parameters": [
          {
            "name": "tenant_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "hostname",
                  "service"
                ],
                "properties": {
                  "hostname": {
                    "type": "string"
                  },
                  "service": {
                    "type": "string",
                    "example": "ordering"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Created",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TenantDomain"
                }
              }
            }
          },
          "400": {
            "description": "Invalid hostname or service"
          },
          "409": {
            "description": "Hostname already connected"
          }
        }
      }
    },
    "/api/v1/admin/tenants/{tenant_id}/domains/{domain_id}/recheck": {
      "post": {
        "tags": [
          "Admin"
        ],
        "summary": "Check a pending domain again now",
        "parameters": [
          {
            "name": "tenant_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "domain_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Updated domain",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TenantDomain"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/admin/tenants/{tenant_id}/domains/{domain_id}": {
      "delete": {
        "tags": [
          "Admin"
        ],
        "summary": "Disconnect a custom domain",
        "description": "Removes its routing, certificate and any DNS record the platform created.",
        "parameters": [
          {
            "name": "tenant_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "domain_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "Removal started; routing, certificate and the platform's DNS record are removed in the background"
          }
        }
      }
    },
    "/healthz": {
      "get": {
        "tags": ["Health"],
        "summary": "Health check",
        "description": "Returns service health status",
        "responses": {
          "200": {
            "description": "Service is healthy",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": { "type": "string", "example": "ok" },
                    "time": { "type": "string", "format": "date-time" }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/auth/register": { "post": { "tags": ["Auth"], "summary": "Register", "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/RegisterRequest" } } } }, "responses": { "201": { "description": "Created" } } } },
    "/api/v1/auth/login": {
      "post": {
        "tags": ["Auth"],
        "summary": "Login",
        "requestBody": {
          "required": true,
          "content": { "application/json": { "schema": { "$ref": "#/components/schemas/LoginRequest" } } }
        },
        "responses": { "200": { "description": "OK" } }
      }
    },
    "/api/v1/auth/refresh": {
      "post": {
        "tags": ["Auth"],
        "summary": "Refresh token",
        "requestBody": {
          "required": true,
          "content": { "application/json": {
            "schema": { "type": "object", "properties": { "refresh_token": { "type": "string", "example": "..." } }, "required": ["refresh_token"] }
          } }
        },
        "responses": { "200": { "description": "OK" } }
      }
    },
    "/api/v1/auth/password-reset/request": { "post": { "tags": ["Auth"], "summary": "Request password reset", "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/PasswordResetRequest" } } } }, "responses": { "200": { "description": "OK" } } } },
    "/api/v1/auth/password-reset/confirm": { "post": { "tags": ["Auth"], "summary": "Confirm password reset", "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/PasswordResetConfirm" } } } }, "responses": { "200": { "description": "OK" } } } },
    "/api/v1/auth/me": {
      "get": { "tags": ["Auth"], "summary": "Current user", "security": [ { "bearerAuth": [] } ], "responses": { "200": { "description": "OK" } } }
    },
    "/api/v1/auth/logout": { "post": { "tags": ["Auth"], "summary": "Logout", "security": [ { "bearerAuth": [] } ], "responses": { "204": { "description": "No Content" } } } },
    "/api/v1/auth/mfa/totp/start": { "post": { "tags": ["Auth"], "summary": "MFA TOTP start", "security": [ { "bearerAuth": [] } ], "responses": { "200": { "description": "OK" } } } },
    "/api/v1/auth/mfa/totp/confirm": { "post": { "tags": ["Auth"], "summary": "MFA TOTP confirm", "security": [ { "bearerAuth": [] } ], "responses": { "200": { "description": "OK" } } } },
    "/api/v1/auth/mfa/backup-codes/regenerate": { "post": { "tags": ["Auth"], "summary": "MFA backup codes regenerate", "security": [ { "bearerAuth": [] } ], "responses": { "200": { "description": "OK" } } } },
    "/api/v1/auth/mfa/backup-codes/consume": { "post": { "tags": ["Auth"], "summary": "MFA backup codes consume", "security": [ { "bearerAuth": [] } ], "responses": { "200": { "description": "OK" } } } },
    "/api/v1/auth/oauth/google/start": { "post": { "tags": ["OAuth"], "summary": "Google OAuth start", "responses": { "200": { "description": "OK" } } } },
    "/api/v1/auth/oauth/google/callback": { "get": { "tags": ["OAuth"], "summary": "Google OAuth callback", "responses": { "200": { "description": "OK" } } } },
    "/api/v1/auth/oauth/github/start": { "post": { "tags": ["OAuth"], "summary": "GitHub OAuth start", "responses": { "200": { "description": "OK" } } } },
    "/api/v1/auth/oauth/github/callback": { "get": { "tags": ["OAuth"], "summary": "GitHub OAuth callback", "responses": { "200": { "description": "OK" } } } },
    "/api/v1/auth/oauth/microsoft/start": { "post": { "tags": ["OAuth"], "summary": "Microsoft OAuth start", "responses": { "200": { "description": "OK" } } } },
    "/api/v1/auth/oauth/microsoft/callback": { "get": { "tags": ["OAuth"], "summary": "Microsoft OAuth callback", "responses": { "200": { "description": "OK" } } } },
    "/api/v1/auth/integrations/active": {
      "get": {
        "tags": ["Auth"],
        "summary": "List active integrations (public)",
        "description": "Returns platform-level and tenant-scoped integrations that are currently active. Used by auth-ui login/signup pages to render only the OAuth providers configured in auth-api.",
        "parameters": [
          { "name": "tenant_slug", "in": "query", "required": false, "schema": { "type": "string" }, "description": "Optional tenant slug to include tenant-scoped integrations in addition to platform-level ones." },
          { "name": "category", "in": "query", "required": false, "schema": { "type": "string", "enum": ["oauth"] }, "description": "Filter by integration category. Currently only 'oauth' is recognised; omit to return all." }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "name": { "type": "string", "example": "google" },
                      "display_name": { "type": "string", "example": "Google OAuth" },
                      "category": { "type": "string", "example": "oauth" },
                      "logo_slug": { "type": "string", "example": "google" },
                      "brand_color": { "type": "string", "example": "#4285F4" }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/.well-known/openid-configuration": {
      "get": { "tags": ["Discovery"], "summary": "OIDC discovery", "responses": { "200": { "description": "OK" } } }
    },
    "/api/v1/.well-known/jwks.json": {
      "get": { "tags": ["Discovery"], "summary": "JWKS", "responses": { "200": { "description": "OK" } } }
    },
    "/api/v1/authorize": { "get": { "tags": ["OAuth"], "summary": "Authorization endpoint (requires auth)", "security": [ { "bearerAuth": [] } ], "responses": { "302": { "description": "Redirect with code" } } } },
    "/api/v1/token": {
      "post": { "tags": ["OAuth"], "summary": "Token endpoint", "responses": { "200": { "description": "OK" } } }
    },
    "/api/v1/userinfo": {
      "get": { "tags": ["OAuth"], "summary": "Userinfo (requires auth)", "security": [ { "bearerAuth": [] } ], "responses": { "200": { "description": "OK" } } }
    },
    "/api/v1/admin/tenants": {
      "get": { "tags": ["Admin"], "summary": "List tenants", "security": [ { "bearerAuth": [] } ], "responses": { "200": { "description": "OK" } } },
      "post": { "tags": ["Admin"], "summary": "Create tenant", "security": [ { "bearerAuth": [] } ], "responses": { "201": { "description": "Created" } } }
    },
    "/api/v1/admin/clients": {
      "get": { "tags": ["Admin"], "summary": "List clients", "security": [ { "bearerAuth": [] } ], "responses": { "200": { "description": "OK" } } },
      "post": { "tags": ["Admin"], "summary": "Create client", "security": [ { "bearerAuth": [] } ], "responses": { "201": { "description": "Created" } } }
    },
    "/api/v1/admin/entitlements": {
      "get": { "tags": ["Admin"], "summary": "List entitlements", "security": [ { "bearerAuth": [] } ], "responses": { "200": { "description": "OK" } } },
      "post": { "tags": ["Admin"], "summary": "Upsert entitlement", "security": [ { "bearerAuth": [] } ], "responses": { "200": { "description": "OK" } } }
    },
    "/api/v1/admin/usage/increment": {
      "post": { "tags": ["Admin"], "summary": "Increment usage metric", "security": [ { "bearerAuth": [] } ], "responses": { "200": { "description": "OK" } } }
    },
    "/api/v1/admin/keys/rotate": {
      "post": { "tags": ["Admin"], "summary": "Rotate signing keys", "security": [ { "bearerAuth": [] } ], "responses": { "204": { "description": "No Content" } } }
    }
  }
}
